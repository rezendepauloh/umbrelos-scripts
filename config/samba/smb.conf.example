[global]
   workgroup = WORKGROUP
   server string = Umbrel Homelab Samba Server
   server role = standalone server
   security = user
   map to guest = Bad User
   dns proxy = no
   log file = /var/log/samba/%m.log
   max log size = 50
   load printers = no
   printing = bsd
   printcap name = /dev/null
   disable spoolss = yes
   vfs objects = catia fruit streams_xattr
   fruit:metadata = stream
   fruit:model = Macmini
   fruit:posix_rename = yes
   fruit:veto_appledouble = no
   fruit:wipe_intentionally_left_blank_rfork = yes
   fruit:delete_empty_adfiles = yes

   # Otimizações de performance
   socket options = TCP_NODELAY IPTOS_LOWDELAY SO_RCVBUF=131072 SO_SNDBUF=131072
   use sendfile = yes

[Usuario1]
   comment = Arquivos Pessoais Usuario1 (HD 2 - disk2)
   path = /home/umbrel/umbrel/external/disk2/users/usuario1
   valid users = usuario1, umbrel
   read only = no
   writable = yes
   browsable = yes
   create mask = 0775
   directory mask = 0775
   force user = umbrel

[Usuario2]
   comment = Arquivos Pessoais Usuario2 (HD 2 - disk2)
   path = /home/umbrel/umbrel/external/disk2/users/usuario2
   valid users = usuario2, umbrel
   read only = no
   writable = yes
   browsable = yes
   create mask = 0775
   directory mask = 0775
   force user = umbrel

[Compartilhado]
   comment = Compartilhamento Comum (HD 2 - disk2)
   path = /home/umbrel/umbrel/external/disk2/shared
   valid users = usuario1, usuario2, umbrel
   read only = no
   writable = yes
   browsable = yes
   create mask = 0775
   directory mask = 0775
   force user = umbrel

[Midia]
   comment = Mídias Homelab - Filmes, Séries, Torrents (HD 1 - disk1)
   path = /home/umbrel/umbrel/external/disk1/media
   valid users = usuario1, usuario2, umbrel
   read only = no
   writable = yes
   browsable = yes
   create mask = 0775
   directory mask = 0775
   force user = umbrel

[Backups]
   comment = Backups Locais (HD 3 - disk3)
   path = /home/umbrel/umbrel/external/disk3/backups
   valid users = usuario1, usuario2, umbrel
   read only = no
   writable = yes
   browsable = yes
   create mask = 0775
   directory mask = 0775
   force user = umbrel
