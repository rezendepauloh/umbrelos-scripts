# ==============================================================================
# umbrelOS Post-Install Configuration (EXAMPLE)
# Arquivo de modelo de configuração de variáveis do Homelab
# Copie este arquivo para 'config.env' e preencha com os seus dados reais:
#   cp config.env.example config.env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Usuários e Permissões
# ------------------------------------------------------------------------------
# Usuário padrão do sistema umbrelOS (geralmente 'umbrel')
SYSTEM_USER="umbrel"
SYSTEM_GROUP="umbrel"

# Usuários Samba adicionais para membros da família / equipe
SAMBA_USER_1="usuario1"
SAMBA_USER_2="usuario2"

# ------------------------------------------------------------------------------
# 2. Configuração de Rede e IP Estático
# ------------------------------------------------------------------------------
# Fixar IP estático no mini PC para nunca mudar após quedas de energia ou reinicializações
SET_STATIC_IP=true
STATIC_IP="192.168.0.100"
STATIC_NETMASK="24"
STATIC_GATEWAY="192.168.0.1"
STATIC_DNS="1.1.1.1 8.8.8.8"
NETWORK_INTERFACE="enp1s0"

# VPN Tailscale & Acesso Remoto (opcional / preenchido se utilizar Tailscale)
TAILSCALE_IP="100.x.y.z"
TAILSCALE_HOSTNAME="seu-umbrel.tailXXXXXX.ts.net"
TAILSCALE_IPV6="fd7a:115c:a1e0::xxxx:xxxx"

# ------------------------------------------------------------------------------
# 3. Discos Externos Nativos (3 HDs externos)
# ------------------------------------------------------------------------------
DISK1_MOUNT="/home/umbrel/umbrel/external/disk1"       # HD 1 (Mídia & Torrents)
DISK2_MOUNT="/home/umbrel/umbrel/external/disk2"       # HD 2 (Nuvem Pessoal & Samba)
DISK3_MOUNT="/home/umbrel/umbrel/external/disk3"       # HD 3 (Backups Locais)

# UUIDs dos discos externos (obtenha executando 'lsblk -f' no terminal)
DISK1_UUID="00000000-0000-0000-0000-000000000001"
DISK2_UUID="00000000-0000-0000-0000-000000000002"
DISK3_UUID="00000000-0000-0000-0000-000000000003"

# Subpastas de Mídia (no disk1)
MEDIA_DIR="${DISK1_MOUNT}/media"
MOVIES_DIR="${MEDIA_DIR}/movies"
SERIES_DIR="${MEDIA_DIR}/series"
MUSIC_DIR="${MEDIA_DIR}/music"
TORRENTS_DIR="${MEDIA_DIR}/torrents"

# Subpastas de Nuvem e Usuários (no disk2)
IMMICH_UPLOAD_DIR="${DISK2_MOUNT}/immich/library"
NEXTCLOUD_DATA_DIR="${DISK2_MOUNT}/nextcloud/data"
USER_1_DIR="${DISK2_MOUNT}/users/${SAMBA_USER_1}"
USER_2_DIR="${DISK2_MOUNT}/users/${SAMBA_USER_2}"
SHARED_DIR="${DISK2_MOUNT}/shared"

# Subpasta de Backups Locais (no disk3)
LOCAL_BACKUP_DIR="${DISK3_MOUNT}/backups"

# ------------------------------------------------------------------------------
# 4. Backup Externo Automatizado (Regra 3-2-1 para máquina remota)
# ------------------------------------------------------------------------------
ENABLE_POPOS_BACKUP=false
POPOS_HOST="192.168.0.50"
POPOS_USER="usuario_remoto"
POPOS_DEST_DIR="/mnt/storage/Backups_Homelab"
POPOS_SSH_KEY="/home/umbrel/.ssh/id_ed25519"
BACKUP_RETENTION_DAYS=7
CHAVE_SSH="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAA... usuario@homelab"

# ------------------------------------------------------------------------------
# 5. Configuração de Rede & Portas dos Serviços Customizados
# ------------------------------------------------------------------------------
TIMEZONE="America/Sao_Paulo"

# Portas das Stacks Docker customizadas
DOCKGE_PORT=5001
DOZZLE_PORT=8888
UPTIME_KUMA_PORT=3001
IT_TOOLS_PORT=8080
SYNCTHING_WEB_PORT=8384
SYNCTHING_TRANSFER_PORT=22000
SYNCTHING_DISCOVERY_PORT=21027

# Nginx Proxy Manager & Domínios Locais Amigáveis
HOMELAB_DOMAIN="homelab.local"
NPM_WEB_PORT=81
NPM_HTTP_PORT=8088
NPM_HTTPS_PORT=8443

# Portas da Stack Arr & Mídia
JELLYSEERR_PORT=5055
RADARR_PORT=7878
SONARR_PORT=8989
BAZARR_PORT=6767
PROWLARR_PORT=9696
JACKETT_PORT=9117
QBITTORRENT_WEB_PORT=8085
QBITTORRENT_TORRENT_PORT=6881

# ------------------------------------------------------------------------------
# 6. Habilitar Módulos de Instalação (true/false)
# ------------------------------------------------------------------------------
ENABLE_SYSTEM_PREP=true
ENABLE_STORAGE_SETUP=true
ENABLE_SAMBA_SETUP=true
ENABLE_DOCKER_STACKS=true
ENABLE_SECURITY_HARDENING=true
